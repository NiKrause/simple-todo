{
  "name": "simple-todo-escrow-contracts",
  "private": true,
  "version": "0.1.0",
  "description": "ConfidentialTodoEscrow: a todo's budget locked in an ERC-7984 confidential token on Zama FHEVM",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "typecheck": "hardhat compile && tsc --noEmit",
    "clean": "hardhat clean && rm -rf fhevmTemp types",
    "deploy:sepolia": "hardhat run scripts/deploy-sepolia.ts --network sepolia"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.6.1",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "encrypted-types": "0.0.4"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.2",
    "@nomicfoundation/hardhat-verify": "2.1.3",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.3",
    "@zama-fhe/relayer-sdk": "0.4.1",
    "chai": "4.5.0",
    "ethers": "6.16.0",
    "hardhat": "2.28.6",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3"
  }
}
