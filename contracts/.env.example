# Read from the environment by `npm run deploy:sepolia` only. Nothing reads
# them from a .env file: export them in the shell that runs the deployment.
# Tests need none of them.

# Any Sepolia JSON-RPC endpoint.
SEPOLIA_RPC_URL=

# A throwaway deployer key with a little Sepolia ETH. Never a key that holds anything.
DEPLOYER_PRIVATE_KEY=

# Required. May decrypt every amount locked in this escrow, for the contract's lifetime.
ESCROW_AUDITOR=

# Optional. Defaults to Zama's cUSDTMock on Sepolia, 0x4E7B06D78965594eB5EF5414c357ca21E1554491.
ESCROW_TOKEN=

# Optional, for `npx hardhat verify --network sepolia ...`.
ETHERSCAN_API_KEY=
