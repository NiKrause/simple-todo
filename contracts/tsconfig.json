{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022"
  },
  "files": ["./hardhat.config.ts"],
  "include": ["scripts/**/*", "test/**/*", "types/**/*"],
  "exclude": ["node_modules"]
}
